# 两套部署方式共用这一份 .env：
#   外部自建服务模式：docker compose up -d --build
#   全 Docker 模式：  docker compose -f docker-compose.yaml -f docker-compose.all-in-docker.yaml up -d --build
# 全 Docker 模式下，DB/Redis/Weaviate 的连接地址会被叠加层改写成容器服务名，
# 下面这些外部地址只在外部自建服务模式下生效。

# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# Database（外部自建服务模式下使用；必须是容器能访问到的地址）
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@your-db-host:5432/llmops?client_encoding=utf8
SQLALCHEMY_ECHO=False

# Redis（compose 不自带 redis，必须是容器能访问到的外部实例）
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_USE_SSL=False

# Weaviate（compose 不自带，指向外部实例）
WEAVIATE_HTTP_HOST=your-weaviate-host
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=your-weaviate-host
WEAVIATE_GRPC_PORT=50051
# 留空表示实例未开鉴权（空值按未配置处理）
WEAVIATE_API_KEY=

# Tencent Cloud COS
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-cos-bucket
COS_REGION=ap-beijing
COS_SCHEME=https
COS_DOMAIN=

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# 必须与实际访问地址一致，否则 OAuth 回调失败
GITHUB_REDIRECT_URI=http://your-host/auth/authorize/github

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key

# LLM Providers
# 每个服务提供者可单独配置 key/base_url；未配置时回落到 OPENAI_* 全局配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
# 辅助 Agent / 会话摘要等使用的模型名
LLM_MODEL=your-llm-model
# 首页辅助会话对应的应用 id（空库时该应用不存在，需要自己建）
ASSISTANT_AGENT_ID=your-assistant-agent-id

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

XIAOMI_API_KEY=your-xiaomi-api-key
XIAOMI_API_BASE_URL=https://your-xiaomi-endpoint/v1

MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_API_BASE_URL=https://api.moonshot.cn/v1

# 本地 Ollama 无需 key
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 向量模型：必须与已有索引使用的模型保持一致，换模型要重 indexes
EMBEDDING_MODEL=qwen3-embedding:8b

QIANFAN_AK=your-qianfan-ak
QIANFAN_SK=your-qianfan-sk

# Tools
GAODE_API_KEY=your-gaode-api-key
SERPER_API_KEY=your-serper-api-key
TAVILY_API_KEY=your-tavily-api-key

# ===== 仅「全 Docker」模式需要 =====
# 对外部自建服务模式无影响，可留空
# postgres 容器密码
POSTGRES_PASSWORD=your-postgres-password
# 本模式 weaviate 容器的 API key，不能为空
WEAVIATE_LOCAL_API_KEY=your-weaviate-local-key
# 本模式 redis 的密码必填（复用上面的 REDIS_PASSWORD）；
# 外部自建服务模式若是不带密码的 redis，这里留空即可，但切到全 Docker 模式前要填上
