# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# Database
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@llmops-db:5432/llmops?client_encoding=utf8
POSTGRES_PASSWORD=your-postgres-password

# Redis
REDIS_PASSWORD=your-redis-password

# Weaviate
WEAVIATE_API_KEY=your-weaviate-api-key

# Tencent Cloud COS
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# LangSmith
LANGCHAIN_API_KEY=your-langsmith-api-key

# LLM Providers
# 每个服务提供者可单独配置 key/base_url；未配置时回落到 OPENAI_* 全局配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

XIAOMI_API_KEY=your-xiaomi-api-key
XIAOMI_API_BASE_URL=https://your-xiaomi-endpoint/v1

MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_API_BASE_URL=https://api.moonshot.cn/v1

# 本地 Ollama 无需 key
OLLAMA_BASE_URL=http://host.docker.internal:11434

QIANFAN_AK=your-qianfan-ak
QIANFAN_SK=your-qianfan-sk

# Tools
GAODE_API_KEY=your-gaode-api-key
SERPER_API_KEY=your-serper-api-key
